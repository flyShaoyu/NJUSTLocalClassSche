<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="0dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@color/sky_top" android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar" app:titleCentered="true" app:popupTheme="@style/ThemeOverlay.ClassSche.Popup" />
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="使用图书馆专用账号密码，状态仅在本机显示。" android:textSize="14sp" android:paddingBottom="12dp" />
<Spinner android:id="@+id/libraryLoginType" android:layout_width="match_parent" android:layout_height="48dp" android:saveEnabled="false" />
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="学号／条码号／证件号"><com.google.android.material.textfield.TextInputEditText android:id="@+id/libraryUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions" android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/libraryPasswordLayout" android:hint="图书馆密码" app:placeholderText="默认密码为身份证后六位" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/libraryPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:saveEnabled="false" android:importantForAutofill="no" /></com.google.android.material.textfield.TextInputLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp"><ImageView android:id="@+id/libraryCaptchaImage" android:layout_width="140dp" android:layout_height="56dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="图形验证码，请手动输入" /><Button android:id="@+id/libraryRefreshCaptcha" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="换一张" /></LinearLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="验证码"><com.google.android.material.textfield.TextInputEditText android:id="@+id/libraryCaptcha" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions" android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" /></com.google.android.material.textfield.TextInputLayout>
<TextView android:id="@+id/libraryLoginStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="正在准备验证码…" android:textSize="13sp" />
<com.google.android.material.button.MaterialButton android:id="@+id/librarySubmit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="登录" android:enabled="false" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textSize="12sp" android:text="登录成功后在本机加密保存账号密码，下次自动填入。状态数据不保存，验证码仍需手动填写。" />
</LinearLayout></ScrollView>
<WebView android:id="@+id/libraryLoginWebView" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="invisible" android:importantForAutofill="noExcludeDescendants" />
</LinearLayout>
